(footprint "MAX98357_Module_Socket" (version 20260206) (generator "pcbnew") (generator_version "10.0") (layer "F.Cu")
  (descr "MAX98357 I2S amplifier module on a 1x7 female header (2.54 mm socket); the module plugs in by its own header pins. Same pad numbering as MAX98357_Module, top view with the header at the bottom: 1 LRC, 2 BCLK, 3 DIN, 4 GAIN, 5 SD, 6 GND, 7 VIN. Pads 8 (-) and 9 (+) mark the module's own screw terminal: small top-copper pads under the solder mask, with no hole, because the speaker wires go into the terminal on the module, not into this board. The module outline on F.Fab (17.8 x 19.3 mm) and the terminal position are UNCONFIRMED")
  (tags "MAX98357 I2S amplifier module socket female header")
  (property "Reference" "REF**" (at 7.62 2.6 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
