  <parts>
    <part ref="Q1" name="BS170" kind="active" qty="1" use="lamp switch" vmax="60" imax="0.5" datasheet="https://example.com/bs170.pdf"/>
    <part ref="R1" name="10k" kind="passive" qty="1" use="pull-up"/>
  </parts>
</device>
