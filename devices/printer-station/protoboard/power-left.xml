<?xml version="1.0" encoding="utf-8"?>
<!-- Printer station on the ElectroCookie full board, for a C3 POWER-LEFT module. U1 sits at numbers 1-8,
     its USB-C end at number 1.
     Checked against the schematic by: python tools/protoboard.py check <this file> -->
<protoboard style="callouts" device="printer-station" hand="power-left" title="Printer station, C3 POWER-LEFT">
  <netlist schematic="../kicad-power-left/printer-station-power-left.kicad_sch"/>
  <offboard ref="U2">PN532 module, wired to the board at J1</offboard>
  <offboard ref="U3">OLED module, wired to the board at J2</offboard>
  <offboard ref="SW1">EC11 encoder, wired to the board at J3</offboard>
  <offboard ref="BZ1">buzzer, wired to the board at J4</offboard>
  <bridge rail="-"/>
  <part ref="U1" kind="c3-supermini" value="ESP32-C3 Super Mini" hand="power-left">
    <pin n="1" hole="H1"/>
    <pin n="2" hole="H2"/>
    <pin n="3" hole="H3"/>
    <pin n="4" hole="H4"/>
    <pin n="5" hole="H5"/>
    <pin n="6" hole="H6"/>
    <pin n="7" hole="H7"/>
    <pin n="8" hole="H8"/>
    <pin n="9" hole="D1"/>
    <pin n="10" hole="D2"/>
    <pin n="11" hole="D3"/>
    <pin n="12" hole="D4"/>
    <pin n="13" hole="D5"/>
    <pin n="14" hole="D6"/>
    <pin n="15" hole="D7"/>
    <pin n="16" hole="D8"/>
  </part>
  <part ref="J3" kind="leads" label="encoder">
    <pin n="1" hole="A5"/>
    <pin n="2" hole="A4"/>
    <pin n="3" hole="B-6"/>
    <pin n="4" hole="A7"/>
    <pin n="5" hole="A3"/>
  </part>
  <part ref="J1" kind="leads" label="PN532">
    <pin n="1" hole="T-1"/>
    <pin n="2" hole="C3"/>
    <pin n="3" hole="I1"/>
    <pin n="4" hole="I2"/>
  </part>
  <part ref="J2" kind="leads" label="OLED">
    <pin n="1" hole="T-3"/>
    <pin n="2" hole="B3"/>
    <pin n="3" hole="J1"/>
    <pin n="4" hole="J2"/>
  </part>
  <part ref="Q1" kind="to92" value="BS170" flat="up">
    <pin n="1" hole="E13"/>
    <pin n="2" hole="E12"/>
    <pin n="3" hole="E11"/>
  </part>
  <part ref="RG1" kind="resistor" value="220 Ω">
    <pin n="1" hole="C8"/>
    <pin n="2" hole="C12"/>
  </part>
  <part ref="RP1" kind="resistor" value="100 kΩ">
    <pin n="1" hole="B12"/>
    <pin n="2" hole="B-12"/>
  </part>
  <part ref="D1" kind="diode" value="1N4001">
    <pin n="1" hole="B+15"/>
    <pin n="2" hole="A15"/>
  </part>
  <part ref="J4" kind="leads" label="buzzer">
    <pin n="1" hole="B+14"/>
    <pin n="2" hole="B13"/>
  </part>
  <wire net="5V" from="A1" to="B+1"/>
  <wire net="GND" from="A2" to="B-2"/>
  <wire net="GND" from="A11" to="B-11"/>
  <wire net="BZ-" from="D13" to="D15"/>
</protoboard>
