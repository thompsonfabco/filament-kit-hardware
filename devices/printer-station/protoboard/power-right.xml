<?xml version="1.0" encoding="utf-8"?>
<!-- Printer station on the ElectroCookie full board, for a C3 POWER-RIGHT module. U1 sits at numbers 1-8,
     its USB-C end at number 1.
     Checked against the schematic by: python tools/protoboard.py check <this file> -->
<protoboard style="callouts" device="printer-station" hand="power-right" title="Printer station, C3 POWER-RIGHT">
  <netlist schematic="../kicad/printer-station.kicad_sch"/>
  <offboard ref="U2">PN532 module, wired to the board at J1</offboard>
  <offboard ref="U3">OLED module, wired to the board at J2</offboard>
  <offboard ref="SW1">EC11 encoder, wired to the board at J3</offboard>
  <offboard ref="BZ1">buzzer, wired to the board at J4</offboard>
  <bridge rail="-"/>
  <part ref="U1" kind="c3-supermini" value="ESP32-C3 Super Mini" hand="power-right">
    <pin n="1" hole="C1"/>
    <pin n="2" hole="C2"/>
    <pin n="3" hole="C3"/>
    <pin n="4" hole="C4"/>
    <pin n="5" hole="C5"/>
    <pin n="6" hole="C6"/>
    <pin n="7" hole="C7"/>
    <pin n="8" hole="C8"/>
    <pin n="9" hole="G1"/>
    <pin n="10" hole="G2"/>
    <pin n="11" hole="G3"/>
    <pin n="12" hole="G4"/>
    <pin n="13" hole="G5"/>
    <pin n="14" hole="G6"/>
    <pin n="15" hole="G7"/>
    <pin n="16" hole="G8"/>
  </part>
  <part ref="J1" kind="leads" label="PN532">
    <pin n="1" hole="T-4"/>
    <pin n="2" hole="H3"/>
    <pin n="3" hole="A1"/>
    <pin n="4" hole="A2"/>
  </part>
  <part ref="J2" kind="leads" label="OLED">
    <pin n="1" hole="T-6"/>
    <pin n="2" hole="I3"/>
    <pin n="3" hole="B1"/>
    <pin n="4" hole="B2"/>
  </part>
  <part ref="J3" kind="leads" label="encoder">
    <pin n="1" hole="H5"/>
    <pin n="2" hole="H4"/>
    <pin n="3" hole="T-8"/>
    <pin n="4" hole="H7"/>
    <pin n="5" hole="J3"/>
  </part>
  <part ref="J4" kind="leads" label="buzzer">
    <pin n="1" hole="T+16"/>
    <pin n="2" hole="F14"/>
  </part>
  <part ref="Q1" kind="to92" value="BS170" flat="up">
    <pin n="1" hole="H14"/>
    <pin n="2" hole="H13"/>
    <pin n="3" hole="H12"/>
  </part>
  <part ref="RG1" kind="resistor" value="220 Ω">
    <pin n="1" hole="I8"/>
    <pin n="2" hole="I13"/>
  </part>
  <part ref="RP1" kind="resistor" value="100 kΩ">
    <pin n="1" hole="F13"/>
    <pin n="2" hole="B-13"/>
  </part>
  <part ref="D1" kind="diode" value="1N4001">
    <pin n="1" hole="T+14"/>
    <pin n="2" hole="I14"/>
  </part>
  <wire net="5V" from="J1" to="T+1"/>
  <wire net="GND" from="J2" to="T-2"/>
  <wire net="GND" from="J12" to="T-12"/>
</protoboard>


