		)
		(property "Imax_basis" "ESP32-C3 chip: vmax is the absolute maximum on the input power pins; imax is the absolute maximum cumulative IO output current, all pins (a whole-chip total, unlike the per-part imax elsewhere); the per-pin limit is UNCONFIRMED and the 40 mA typical is in i_typ. The board's 3V3 regulator rating and 5 V pin path are UNCONFIRMED"
			(at 0 0 90)
			(layer "F.SilkS")
			(hide yes)
			(uuid "ec59c169-4096-4fb4-862b-c3a54706f39a")
			(effects
				(font
