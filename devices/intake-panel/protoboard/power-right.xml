<?xml version='1.0' encoding='utf-8'?>
<protoboard style="callouts" device="intake-panel" hand="power-right" title="Intake panel, C3 POWER-RIGHT">
  <netlist schematic="../kicad/intake-panel.kicad_sch" />
  <offboard ref="U3">OLED module, wired to the board at J1</offboard>
  <offboard ref="U4">air sensor board, wired to the board at J2</offboard>
  <offboard ref="U5">air sensor board (option B), wired to the board at J2</offboard>
  <offboard ref="U6">air sensor board (option B), wired to the board at J2</offboard>
  <offboard ref="U7">PN532 reader, wired to the board at J7</offboard>
  <offboard ref="SW1">yellow button, wired to the board at J3</offboard>
  <offboard ref="SW2">red button, wired to the board at J4</offboard>
  <offboard ref="BZ1">buzzer, wired to the board at J5</offboard>
  <offboard ref="LS1">speaker, in U2's screw terminal</offboard>
  <offboard ref="RI1">I2C pull-up, not fitted on the protoboard build</offboard>
  <offboard ref="RI2">I2C pull-up, not fitted on the protoboard build</offboard>
  <offboard ref="C1">bulk capacitor, not fitted on the protoboard build</offboard>
  <bridge rail="-" />
  <part ref="U1" kind="c3-supermini" value="ESP32-C3 Super Mini" hand="power-right">
    <pin n="1" hole="D1" /><pin n="2" hole="D2" /><pin n="3" hole="D3" /><pin n="4" hole="D4" />
    <pin n="5" hole="D5" /><pin n="6" hole="D6" /><pin n="7" hole="D7" /><pin n="8" hole="D8" />
    <pin n="9" hole="H1" /><pin n="10" hole="H2" /><pin n="11" hole="H3" /><pin n="12" hole="H4" />
    <pin n="13" hole="H5" /><pin n="14" hole="H6" /><pin n="15" hole="H7" /><pin n="16" hole="H8" />
  </part>
  <part ref="U2" kind="module" value="MAX98357" label="amplifier" extends="down" terminal="SPEAKER" fit="with its screw terminal toward the bottom edge">
    <pin n="1" hole="D10" name="LRC" />
    <pin n="2" hole="D11" name="BCLK" />
    <pin n="3" hole="D12" name="DIN" />
    <pin n="4" hole="D13" name="GAIN" />
    <pin n="5" hole="D14" name="SD" />
    <pin n="6" hole="D15" name="GND" />
    <pin n="7" hole="D16" name="VIN" />
    <pin n="8" on="module" at="5.08,12.7" name="−" />
    <pin n="9" on="module" at="10.16,12.7" name="+" />
  </part>
  <part ref="J1" kind="leads" label="OLED">
    <pin n="1" hole="B-22" />
    <pin n="2" hole="B+22" />
    <pin n="3" hole="D18" />
    <pin n="4" hole="D19" />
  </part>
  <part ref="J2" kind="leads" label="AIR">
    <pin n="1" hole="B-25" />
    <pin n="2" hole="B+25" />
    <pin n="3" hole="B18" />
    <pin n="4" hole="B19" />
  </part>
  <part ref="J7" kind="leads" label="NFC">
    <pin n="1" hole="B-28" />
    <pin n="2" hole="B+28" />
    <pin n="3" hole="E18" />
    <pin n="4" hole="C19" />
  </part>
  <part ref="J3" kind="leads" label="YELLOW">
    <pin n="1" hole="T-9" />
    <pin n="2" hole="I5" />
    <pin n="3" hole="T+9" />
    <pin n="4" hole="J10" />
  </part>
  <part ref="J4" kind="leads" label="RED">
    <pin n="1" hole="T-23" />
    <pin n="2" hole="J4" />
    <pin n="3" hole="T+23" />
    <pin n="4" hole="J26" />
  </part>
  <part ref="J5" kind="leads" label="BUZZER">
    <pin n="1" hole="T-7" />
    <pin n="2" hole="I3" />
    <pin n="3" hole="J8" />
  </part>
  <part ref="Q1" kind="to92" value="BS170" flat="down">
    <pin n="1" hole="H10" />
    <pin n="2" hole="H11" />
    <pin n="3" hole="H12" />
  </part>
  <part ref="Q2" kind="to92" value="BS170" flat="down">
    <pin n="1" hole="G26" />
    <pin n="2" hole="G27" />
    <pin n="3" hole="G28" />
  </part>
  <part ref="RG1" kind="resistor" value="220 Ω">
    <pin n="1" hole="F7" />
    <pin n="2" hole="F11" />
  </part>
  <part ref="RP1" kind="resistor" value="100 kΩ">
    <pin n="1" hole="J11" />
    <pin n="2" hole="T-11" />
  </part>
  <part ref="RG2" kind="resistor" value="220 Ω">
    <pin n="1" hole="I24" />
    <pin n="2" hole="I27" />
  </part>
  <part ref="RP2" kind="resistor" value="100 kΩ">
    <pin n="1" hole="J27" />
    <pin n="2" hole="T-27" />
  </part>
  <part ref="RSD1" kind="resistor" value="10 kΩ" dnp="the amplifier's SD pin reads near 0 V in the SD pull-up check">
    <pin n="1" hole="B+14" />
    <pin n="2" hole="A14" />
  </part>
  <wire net="+5V" from="J1" to="T+1" />
  <wire net="GND" from="J2" to="T-2" />
  <wire net="+3V3" from="G3" to="B+21" route="hv" />
  <wire net="I2S_LRC" from="E7" to="E10" />
  <wire net="I2S_BCLK" from="B6" to="B11" />
  <wire net="I2S_DIN" from="A8" to="A12" />
  <wire net="GND" from="A15" to="B-15" />
  <wire net="+5V" from="T+16" to="E16" />
  <wire net="SDA" from="C1" to="C18" />
  <wire net="SCL" from="E2" to="E19" route="channel" y="27.8" />
  <wire net="LAMP_DISCARD" from="E3" to="F24" route="channel" y="25.2" />
  <wire net="GND" from="J12" to="T-12" />
  <wire net="GND" from="J28" to="T-28" />
</protoboard>