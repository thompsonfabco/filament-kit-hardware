	(footprint "filament-kit:ESP32-C3_SuperMini_Socket"
		(layer "F.Cu")
		(uuid "c866d45d-0137-4fa2-9b8e-d849cc0bd3a0")
		(at 107.67 133.62 90)
		(descr "ESP32-C3 Super Mini on two 1x8 female headers (2.54 mm sockets), 15.24 mm between rows; the module plugs in and is never soldered. POWER-RIGHT modules: top view, USB at the top: pads 1-8 left row top to bottom GPIO5 GPIO6 GPIO7 GPIO8 GPIO9 GPIO10 GPIO20 GPIO21, pads 9-16 right row top to bottom 5V GND 3V3 GPIO4 GPIO3 GPIO2 GPIO1 GPIO0. Pad positions match the other hand's socket; only the numbering is swapped between the rows. Module outline 18 x 22.52 mm centred on the pins. A rule area under the antenna end (the end away from USB) keeps tracks, vias and copper pour out; the antenna position on the module is UNCONFIRMED")
		(tags "ESP32-C3 SuperMini module socket female header power-right")
		(property "Reference" "U1"
			(at 7.62 22.529999 0)
