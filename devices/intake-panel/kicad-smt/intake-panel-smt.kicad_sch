		(property "Description" "PN532 NFC module in I2C mode (address 0x24): I2C header plus the IRQ and RSTO pins, which stay unconnected"
			(at 355.6 142.24 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
    (property "Vmax" "6.0" (at 355.6 142.24 0)
      (effects (font (size 1.27 1.27)) (hide yes))
    )
    (property "Imax" "0.14" (at 355.6 142.24 0)
      (effects (font (size 1.27 1.27)) (hide yes))
    )
    (property "Imax_basis" "operating maximum, Table 1; Table 13 gives no supply-current limit (PN532/C1 short form data sheet Rev. 1.2; vmax is the Table 13 VBAT limit, 6.0 V). The module's path from VCC to VBAT and PVDD is UNCONFIRMED; fed from 3V3, VCC is under the VBAT 6.0 V limit, and under the PVDD 4 V limit if VCC also reaches PVDD" (at 355.6 142.24 0)
      (effects (font (size 1.27 1.27)) (hide yes))
    )
    (property "Pin_order" "Elechouse NFC Module V3, confirmed from the board: 4-pin header left to right GND VCC SDA SCL on the component side (the back labels the same holes GND VCC TXD RXD); side header SCK MISO MOSI SS VCC GND IRQ RSTO; IRQ and RSTO stay unconnected. Pin numbers here are symbol numbers, not header positions" (at 355.6 142.24 0)
      (effects (font (size 1.27 1.27)) (hide yes))
    )
    (property "Mode" "I2C: the chip needs I0 high and I1 low (PN532 User Manual, Table 7). On the Elechouse NFC Module V3 switch 1 is I0 (its silkscreen reads I2C 1): set switch 1 ON and switch 2 OFF. Switch 2's silkscreen row is not legible, so its OFF setting comes from Table 7" (at 355.6 142.24 0)
      (effects (font (size 1.27 1.27)) (hide yes))
    )
